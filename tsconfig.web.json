{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "isolatedModules": true,
    "types": ["vite/client", "vitest/globals"]
  },
  "include": ["web/**/*.ts", "web/**/*.tsx"],
  "exclude": ["web/**/*.test.ts", "web/**/*.test.tsx", "dist", "node_modules"]
}
