{
  "name": "legacy-ui-capability-engine",
  "version": "1.0.0",
  "private": true,
  "description": "LLM discovery to typed capability artifacts with deterministic, model-free UI replay.",
  "type": "module",
  "engines": {
    "node": ">=22.12 <27"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run test && npm run build",
    "demo": "tsx src/demo/standalone.ts",
    "discover": "tsx src/cli.ts discover",
    "replay": "tsx src/cli.ts replay",
    "evidence": "tsx scripts/generate-evidence.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "commander": "15.0.0",
    "openai": "7.4.0",
    "playwright": "1.62.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pngjs": "6.0.5",
    "pngjs": "7.0.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
