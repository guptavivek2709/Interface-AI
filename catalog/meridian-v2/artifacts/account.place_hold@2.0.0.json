    "name": "Place account hold",
    "description": "Place a supervisor-only share hold through review and an approval-bound final post.",
    "version": "2.0.0",
    "approval": "approved",
    "risk": "supervisor_only",
    "tags": [
      "meridian",
      "deterministic-replay",
      "discovered-v2"
    ]
  },
  "provenance": {
    "source": "discovery",
    "createdAt": "2026-08-21T06:08:33.853Z",
    "goal": "Perform these numbered actions in this exact order, without skipping any action even when the current page already appears to be the destination: (1) FIRST click the visible Main Menu link; (2) SECOND click Member Inquiry; (3) select Member Number mode; (4) fill {{member_number}}; (5) click Search; (6) select the exact member row keyed by {{member_number}}; (7) extract the Status cell for the row keyed by {{share}} as output share_status_before using that exact output name; (8) click Place Account Hold; (9) select Share from {{share}}; (10) select Reason from {{reason}}; (11) fill Notes from {{notes}}; (12) click Continue exactly once; (13) finish on the account-hold review heading. Never click Apply Hold, Save, Confirm, Post, or any final commit control.",
    "discoveryRunId": "discovery.5d8a7d98-4fa3-4000-ba55-9ce5ea31dc6b",
    "planner": {
      "provider": "anthropic-messages",
      "model": "claude-sonnet-5"
    }
  },
