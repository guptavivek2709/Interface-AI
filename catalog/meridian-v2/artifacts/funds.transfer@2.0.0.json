{
  "schemaVersion": "2.0",
  "capability": {
    "id": "funds.transfer",
    "name": "Transfer funds",
    "description": "Transfer funds between member shares through review and an approval-bound final post.",
    "version": "2.0.0",
    "approval": "approved",
    "risk": "irreversible",
    "tags": [
      "meridian",
      "deterministic-replay",
      "discovered-v2"
    ]
  },
  "provenance": {
    "source": "discovery",
    "createdAt": "2026-08-21T06:10:04.016Z",
    "goal": "Follow exactly this safe, non-persistent sequence, one UI action per turn: click Main Menu; click Member Inquiry / Selection; select search mode number as a literal; fill the member search field from {{member_number}}; click Search; click the exact Select control in the result row bound to {{member_number}}; extract the Balance cell from the share row keyed by {{from_share}} as source_balance_before with money output type; extract the Balance cell from the share row keyed by {{to_share}} as destination_balance_before with money output type; click Funds Transfer; select the source share from {{from_share}}; select the destination share from {{to_share}}; fill the transfer amount from {{amount}}; fill the memo from {{memo}}; click Continue. Then STOP and finish only when the CONFIRM FUNDS TRANSFER heading is visible on the review page before posting. Never click Post Transfer. Extract exactly source_balance_before and destination_balance_before, with no other outputs.",
    "discoveryRunId": "discovery.3a4ddec6-1a5e-4935-b320-65b45a33b435",
    "planner": {
      "provider": "anthropic-messages",
      "model": "claude-sonnet-5"
    }
  },
  "compatibility": {
    "surfaceAdapter": "playwright-web-meridian-v2",
    "vendorProduct": "Meridian Core",
    "appVersion": "4.2.1",
    "entryPoint": "https://meridian-core.vendor.invalid/signon"
  },
