# OpenAI Responses API planner
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Anthropic Messages API planner
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_CALL_TIMEOUT_MS=120000

# Anthropic is the primary console chat/intent router. With CHAT_OFFLINE=0 a
# missing key fails startup instead of silently changing provider behavior.
# Set CHAT_OFFLINE=1 only for explicit deterministic development/test mode.
ANTHROPIC_CHAT_MODEL=claude-sonnet-5
ANTHROPIC_CHAT_EFFORT=low
# Production API range is 1000-18000; the browser deadline is 20000.
ANTHROPIC_CHAT_TIMEOUT_MS=12000
CHAT_OFFLINE=0

# Optional authenticated Codex CLI planner used to generate the checked-in evidence.
# CODEX_CLI_PATH=codex
# CODEX_MODEL=gpt-5.6-terra
# CODEX_CALL_TIMEOUT_MS=120000

# Demo defaults
DEMO_BASE_URL=http://127.0.0.1:4317
OPERATOR_PORT=4318

# MERIDIAN capability console (all secrets stay server-side).
HOST=127.0.0.1
PORT=8787
MERIDIAN_ORIGIN=https://web-sample.interface-hiring.com
MERIDIAN_HEADFUL=0
MAX_CONCURRENT_RUNS=2
MAX_QUEUED_RUNS=100
RUN_RETENTION_TTL_MS=28800000
SESSION_IDLE_TTL_MS=600000
SESSION_LEASE_WAIT_TIMEOUT_MS=30000
EVIDENCE_ROOT=evidence/generated/api-runs
# Durable fail-closed bindings for risky-operation Idempotency-Key values.
IDEMPOTENCY_LEDGER_PATH=.meridian/idempotency-ledger.json

# Console identity. Use different randomly generated values of at least 16
# characters. The browser exchanges one for an HttpOnly, SameSite=Strict cookie.
MERIDIAN_CONSOLE_TELLER_ACCESS_CODE=
MERIDIAN_CONSOLE_TELLER_SUBJECT=
MERIDIAN_CONSOLE_TELLER_DISPLAY_NAME=
MERIDIAN_CONSOLE_SUPERVISOR_ACCESS_CODE=
MERIDIAN_CONSOLE_SUPERVISOR_SUBJECT=
MERIDIAN_CONSOLE_SUPERVISOR_DISPLAY_NAME=
CONSOLE_COOKIE_SECURE=0

# Credentials used only by the server-owned MERIDIAN browser session.
MERIDIAN_TELLER_OPERATOR=teller1
MERIDIAN_TELLER_PASSWORD=
MERIDIAN_SUPERVISOR_OPERATOR=super1
MERIDIAN_SUPERVISOR_PASSWORD=

# Stable HMAC key for approval tokens. Use at least 32 random bytes. Prefix a
# base64-encoded value with `base64:`. If omitted, restarts invalidate approvals.
APPROVAL_SIGNING_SECRET=

# Vite development proxy only; production uses the same Fastify origin.
VITE_API_ORIGIN=http://127.0.0.1:8787
